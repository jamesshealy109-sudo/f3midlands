---
import '../styles/global.css';
import '../styles/facelift.css';
import aos from '../data/aos.json';
import { aoSlug, regionSlug, SITE_URL, visibleListings, type AoListing } from '../lib/seo';
const visibleAos = visibleListings(aos as unknown as AoListing[]);

const regions = [...new Set(visibleAos.map((ao) => ao.region).filter(Boolean))];
const defaultRegion = regions[0] || 'all';
const types = [...new Set(visibleAos.map((ao) => ao.type).filter(Boolean))].sort();
const totalAos = visibleAos.length;
const regionLine = regions.join(' • ');
const descriptionRegions = regions.join(', ');
const pageTitle = "Free Men's Workouts in Columbia & Lexington, SC | F3 Midlands";
const pageDescription = `Find free, peer-led outdoor workouts for men across ${descriptionRegions || 'Lexington, Columbia, Lake Murray, Camden, and Saluda'}. No fees, no signup, and all fitness levels welcome.`;
const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'F3 Midlands',
  alternateName: 'F3 Lexington and Midlands',
  url: SITE_URL,
  description: pageDescription,
  publisher: {
    '@type': 'Organization',
    name: 'F3 Midlands',
    url: SITE_URL,
    logo: `${SITE_URL}/assets/f3-logo.png`,
    sameAs: ['https://www.facebook.com/F3LexSC/', 'https://f3nation.com/'],
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={`${SITE_URL}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="F3 Midlands" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={`${SITE_URL}/`} />
    <meta property="og:image" content={`${SITE_URL}/assets/f3-lexington-community.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${SITE_URL}/assets/f3-lexington-community.jpg`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
    <link
  rel="icon"
  type="image/png"
  sizes="512x512"
  href="/assets/f3-logo.png"
/>
  </head>
  <body data-default-region={defaultRegion}>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="F3 Midlands home">
        <img class="header-f3-logo" src="/assets/f3-logo.png" alt="F3" />
        <span>F3 Midlands</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#new">I'm New</a>
<a href="#today">Today</a>
<a href="#find">Find an AO</a>
<a href="#contact">Talk to a Local</a>
        <a class="nav-social" href="https://www.facebook.com/F3LexSC/" target="_blank" rel="noopener noreferrer">F3 Lexington <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="hero-content">
          <div class="hero-mark" aria-hidden="true"><img src="/assets/f3-logo.png" alt="" /></div>
          <p class="eyebrow">F3 Midlands • {regionLine || 'Lexington • Columbia • Lake Murray • Camden • Saluda'}</p>
          <h1>The Midlands gets stronger before sunrise.</h1>
          <p class="lead">Every week, men across our towns lace up, show up, and push one another forward. Your first workout is free. So is every one after that.</p>
          <div class="hero-actions">
            <a class="button primary" href="#new">Start Here</a>
	   <a class="button ghost" href="#today">Today’s Workouts</a>
          </div>
          <div class="stats" aria-label="F3 Midlands quick stats">
            <div><strong>{totalAos}</strong><span>Places to post</span></div>
            <div><strong>{regions.length}</strong><span>Local regions</span></div>
            <div><strong>$0</strong><span>Cost</span></div>
            <div><strong>365</strong><span>Rain or shine</span></div>
          </div>
        </div>
      </section>

<section id="new" class="section new-section">
  <div class="new-card start-layout">

    <div class="start-copy">

      <p class="eyebrow">Start Here</p>

      <h2>You don't need to be in shape. You just need to show up.</h2>

      <p>
        Every man out there remembers his first morning in the gloom. Come as
        you are, arrive 10 minutes early, and tell the first guy you see that
        you're new. We'll take it from there.
      </p>

      <div class="new-grid">

        <div>
          <strong>Bring</strong>
          <span>Water, gloves, shoes, and a good attitude.</span>
        </div>

        <div>
          <strong>Arrive</strong>
          <span>Show up 10 minutes early and introduce yourself.</span>
        </div>

        <div>
          <strong>Expect</strong>
          <span>Rain or shine. Nobody gets left behind.</span>
        </div>

      </div>

      <a class="button primary" href="#today">
        Find Today's Workout
      </a>

    </div>

    <div class="start-video">

      <iframe
        src="https://player.vimeo.com/video/143444379?title=0&byline=0&portrait=0"
        allowfullscreen
      ></iframe>

    </div>

  </div>
</section>

<section class="section community-section" aria-labelledby="community-title">
  <div class="community-shell">
    <figure class="community-photo">
      <img src="/assets/f3-lexington-community.jpg" alt="A large F3 Lexington community gathering" />
      <figcaption>F3 Lexington • Established 12.19.2014</figcaption>
    </figure>

    <div class="community-copy">
      <p class="eyebrow">More than a workout</p>
      <h2 id="community-title">These are the men who will know your name.</h2>
      <p>We meet in dark parking lots and finish as the sun comes up. We sweat together, laugh together, and keep showing up for one another long after the workout ends.</p>
      <div class="three-f" aria-label="The three Fs">
        <span><b>01</b> Fitness</span>
        <span><b>02</b> Fellowship</span>
        <span><b>03</b> Faith</span>
      </div>
      <p class="community-note"><strong>New guy promise:</strong> You will not be left behind, and you will not finish alone.</p>
      <a class="button facebook-button" href="https://www.facebook.com/F3LexSC/" target="_blank" rel="noopener noreferrer">Follow F3 Lexington <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<section id="today" class="section today-section today-compact-section" aria-labelledby="today-title">
  <div class="section-heading wide today-compact-heading">
    <p class="eyebrow" id="today-eyebrow">Today</p>
    <h2 id="today-title">Where are you posting today?</h2>
    <p id="today-subtitle">Choose a region to see the next listed workouts.</p>
  </div>

  <div class="today-shell">
    <div class="today-toolbar">
      <div class="today-summary">
        <strong id="todaySummaryLabel">Today’s workouts</strong>
        <span id="todaySummaryText">Pick a region below.</span>
      </div>

      <div class="today-region-chips" aria-label="Filter today workouts by region">
        {regions.map((region) => (
          <button
            class="today-chip"
            type="button"
            data-today-region={region}
          >
            {region}
          </button>
        ))}
      </div>
    </div>

    <div class="today-grid today-compact-grid" id="todayGrid" hidden>
      {visibleAos.map((ao) => (
        <article
          class="today-card today-compact-card"
          data-region={ao.region}
          data-schedule={JSON.stringify(ao.schedule || [])}
          data-fallback-days={(ao.days || '').toLowerCase()}
          data-fallback-time={ao.time}
          data-fallback-map={ao.mapUrl || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ao.address)}`}
          data-fallback-address={ao.address}
          hidden
        >
          <div class="today-compact-main">
            <div>
              <span>{ao.type}</span>
              <h3><a class="ao-name-link" href={`/workouts/${aoSlug(ao)}/`}>{ao.name}</a></h3>
              <p class="today-card-meta">{ao.region} • {ao.city} • {ao.time}</p>
            </div>

            <div class="today-card-actions">
              <a class="ao-detail-link" href={`/workouts/${aoSlug(ao)}/`} aria-label={`View ${ao.name} workout page`}>View AO page</a>
              <a
                class="map-link today-compact-link"
                href={ao.mapUrl || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ao.address)}`}
                target="_blank"
                rel="noreferrer"
              >
                Directions
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="today-empty" id="todayEmpty">Pick a region to see workouts.</p>
  </div>
</section>

      <section id="find" class="section finder finder-app" aria-labelledby="find-title">
        <div class="section-heading wide finder-heading">
          <p class="eyebrow">AO Finder</p>
          <h2 id="find-title">There's a shovel flag waiting for you.</h2>
          <p>Pick your part of the Midlands, choose the kind of workout you want, and meet the men who post there.</p>
          <nav class="region-seo-links" aria-label="Explore workouts by region">
            {regions.map((region) => <a href={`/regions/${regionSlug(region)}/`}>Workouts in {region}</a>)}
          </nav>
        </div>

        <div class="finder-shell">
          <div class="finder-toolbar" role="search">
            <label class="finder-search">
              <span class="sr-only">Search AOs</span>
              <input id="search" type="search" placeholder="Search AO, city, address, day, workout type..." />
            </label>

            <select id="typeFilter" aria-label="Filter by workout type">
              <option value="all">All workout types</option>
              {types.map((type) => <option value={type}>{type}</option>)}
            </select>
          </div>

          <div class="finder-region-chips" aria-label="Filter by region">
            <button class="region-chip" type="button" data-region-filter="all">All</button>
            {regions.map((region) => (
              <button class:list={["region-chip", region === defaultRegion && "is-active"]} type="button" data-region-filter={region}>{region}</button>
            ))}
          </div>

          <div class="finder-summary">
            <strong><span id="visibleCount">{visibleAos.filter((ao) => ao.region === defaultRegion).length}</span> AO listings</strong>
            <span id="finderSummaryText">in {defaultRegion}</span>
          </div>
        </div>

        <div class="ao-grid compact-ao-grid" id="aoGrid">
         {visibleAos.map((ao) => (
            <article
              class="ao-card compact-ao-card"
              data-region={ao.region}
              data-type={ao.type}
              data-search={`${ao.name} ${ao.region} ${ao.city} ${ao.type} ${ao.days} ${ao.time} ${ao.address} ${ao.notes} ${ao.email || ''} ${ao.scheduleSummary || ''}`.toLowerCase()}
              id={ao.id}
              hidden={ao.region !== defaultRegion}
            >
              <div class="compact-card-main">
                <div>
                  <div class="card-top compact-card-top">
                    <span class="type-pill">{ao.type}</span>
                    <span>{ao.region}</span>
                  </div>
                  <h3><a class="ao-name-link" href={`/workouts/${aoSlug(ao)}/`}>{ao.name}</a></h3>
                </div>

                <div class="compact-card-links">
                  <a class="ao-detail-link" href={`/workouts/${aoSlug(ao)}/`} aria-label={`View ${ao.name} workout page`}>View AO page</a>
                  <a
                    class="map-link compact-map-link"
                    href={ao.mapUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Directions
                  </a>
                </div>
              </div>

              <div class="compact-card-details">
                <div>
                  <dt>When</dt>
                  <dd>{ao.days}<br />{ao.time}</dd>
                </div>
                <div>
                  <dt>Where</dt>
                  <dd>{ao.location || ao.address}</dd>
                </div>
              </div>

              <p>{ao.notes}</p>
              {(ao.email || ao.phone) && (
                <p class="ao-contact">
                  {ao.email && <a href={`mailto:${ao.email}`}>{ao.email}</a>}
                  {ao.email && ao.phone && <span> • </span>}
                  {ao.phone && <a href={`tel:${ao.phone}`}>{ao.phone}</a>}
                </p>
              )}
            </article>
          ))}
        </div>

        <p class="finder-empty" id="finderEmpty" hidden>No AOs match those filters.</p>
      </section>
      <section id="faq" class="section faq-section" aria-labelledby="faq-title">
        <div class="section-heading wide">
          <p class="eyebrow">Your first workout</p>
          <h2 id="faq-title">Questions every new guy asks.</h2>
        </div>
        <div class="faq-grid">
          <article><h3>Is F3 really free?</h3><p>Yes. Every F3 workout is free. There are no memberships, contracts, or required purchases.</p></article>
          <article><h3>Do I need to be in shape?</h3><p>No. Start where you are and modify any movement you need to. The group will challenge you without leaving you behind.</p></article>
          <article><h3>Who can participate?</h3><p>F3 workouts are open to all men, regardless of age, background, or current fitness level.</p></article>
          <article><h3>What is an AO?</h3><p>AO means Area of Operations—the local park, school, track, or parking lot where an F3 group meets.</p></article>
          <article><h3>What should I bring?</h3><p>Bring water, work gloves, comfortable shoes, and clothes you can move in. Arrive about 10 minutes early.</p></article>
          <article><h3>What happens if it rains?</h3><p>We still post. F3 meets outdoors, rain or shine, throughout the year.</p></article>
        </div>
      </section>

      <section id="contact" class="section contact-section" aria-labelledby="contact-title">
        <div class="contact-grid help-grid">
          <div>
            <p class="eyebrow">Talk to a Local</p>
            <h2 id="contact-title">A real person will help you pick your first workout.</h2>
            <p>Tell us roughly where you live and what mornings work. A local PAX—not a bot or a mailing list—will point you toward a nearby group and make sure someone is looking for you when you arrive.</p>

            <div class="hero-actions help-actions">
              <a class="button primary" href="#contactForm">Send us a message</a>
              <a class="button ghost" href="https://map.f3nation.com/?lat=33.990100&lng=-81.252600&zoom=10" target="_blank" rel="noreferrer">Open official map</a>
            </div>
          </div>

          <form
            id="contactForm"
            class="contact-form"
            action="https://formsubmit.co/f3lexington@gmail.com"
            method="POST"
          >
            <input type="hidden" name="_subject" value="New F3 Midlands contact form submission" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_next" value="https://f3midlands.com/#contact" />

            <label>Name<input name="name" required /></label>
            <label>Email<input type="email" name="email" required /></label>
            <label>Message<textarea name="message" rows="4" required placeholder="Tell us where you live and what day you want to try." ></textarea></label>
            <button class="button primary" type="submit">Send message</button>
          </form>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-brand">
        <img src="/assets/f3-logo.png" alt="F3" />
        <span>F3 Midlands</span>
      </div>

      <div class="footer-links">
        <a
          class="social-link"
          href="https://www.facebook.com/F3LexSC/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Follow us on Facebook"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.6 1.6-1.6H17V4.8c-.4-.1-1.3-.2-2.5-.2-2.5 0-4.2 1.5-4.2 4.4V11H7.5v3h2.8v8h3.2z"/>
          </svg>
        </a>

        <a
          class="social-link strataworks-link"
          href="https://strataworks.tech"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Site by StrataWorks"
          title="Site by StrataWorks"
        >
          <img src="/assets/strataworks-logo.png" alt="StrataWorks" />
        </a>

        <a class="footer-signature" href="https://strataworks.tech" target="_blank" rel="noopener noreferrer">
          Site by StrataWorks
        </a>

        <a href="#top">Back to top</a>
      </div>
    </footer>

    <script>
      const search = document.querySelector('#search');
      const typeFilter = document.querySelector('#typeFilter');
      const cards = [...document.querySelectorAll('.ao-card')];
      const visibleCount = document.querySelector('#visibleCount');
      const finderSummaryText = document.querySelector('#finderSummaryText');
      const finderEmpty = document.querySelector('#finderEmpty');
      const regionChips = [...document.querySelectorAll('[data-region-filter]')];

      const defaultRegion = document.body.dataset.defaultRegion || 'all';
      let activeRegion = defaultRegion;

      function applyFilters() {
        const q = search?.value.trim().toLowerCase() || '';
        const type = typeFilter?.value || 'all';
        let visible = 0;

        cards.forEach((card) => {
          const matchesText = !q || card.dataset.search.includes(q);
          const matchesRegion = activeRegion === 'all' || card.dataset.region === activeRegion;
          const matchesType = type === 'all' || card.dataset.type === type;
          const show = matchesText && matchesRegion && matchesType;

          card.hidden = !show;
          if (show) visible++;
        });

        if (visibleCount) visibleCount.textContent = visible;

        if (finderSummaryText) {
          const regionText = activeRegion === 'all' ? 'across all Midlands regions' : `in ${activeRegion}`;
          const typeText = type === 'all' ? '' : ` • ${type}`;
          finderSummaryText.textContent = `${regionText}${typeText}`;
        }

        if (finderEmpty) finderEmpty.hidden = visible !== 0;
      }

      regionChips.forEach((button) => {
        button.addEventListener('click', () => {
          activeRegion = button.dataset.regionFilter || 'all';

          regionChips.forEach((chip) => chip.classList.toggle('is-active', chip === button));

          applyFilters();
        });
      });

      [search, typeFilter].forEach((el) => {
        if (el) el.addEventListener('input', applyFilters);
      });

      applyFilters();

const dayMap = {
  0: ['sun', 'sunday'],
  1: ['mon', 'monday'],
  2: ['tue', 'tuesday'],
  3: ['wed', 'wednesday'],
  4: ['thu', 'thursday'],
  5: ['fri', 'friday'],
  6: ['sat', 'saturday']
};

const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const todayCards = [...document.querySelectorAll('.today-card')];
const todayEmpty = document.querySelector('#todayEmpty');
      const todayTitleEl = document.querySelector('#today-title');
      const todayEyebrowEl = document.querySelector('#today-eyebrow');
      const todaySubtitleEl = document.querySelector('#today-subtitle');
      const todayGridEl = document.querySelector('#todayGrid');
      const todayCardsEl = [...document.querySelectorAll('.today-card')];
      const todayEmptyEl = document.querySelector('#todayEmpty');
      const todayRegionButtonsEl = [...document.querySelectorAll('[data-today-region]')];
      const todaySummaryLabelEl = document.querySelector('#todaySummaryLabel');
      const todaySummaryTextEl = document.querySelector('#todaySummaryText');

      const todayDayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      const todayNow = new Date();
      const todayAfterCutoff = todayNow.getHours() >= 7;
      const todayTargetDate = new Date(todayNow);
      if (todayAfterCutoff) todayTargetDate.setDate(todayTargetDate.getDate() + 1);
      const todayTargetDay = todayDayNames[todayTargetDate.getDay()];
      const todayLabel = todayAfterCutoff ? 'Tomorrow' : 'Today';

      if (todayTitleEl) {
        todayTitleEl.textContent = todayAfterCutoff ? 'Where are you posting tomorrow?' : 'Where are you posting today?';
      }

      if (todayEyebrowEl) {
        todayEyebrowEl.textContent = todayLabel;
      }

      if (todaySubtitleEl) {
        todaySubtitleEl.textContent = `Choose a region to see ${todayTargetDay}'s workouts.`;
      }

      if (todaySummaryLabelEl) {
        todaySummaryLabelEl.textContent = `${todayLabel}'s workouts`;
      }

      if (todaySummaryTextEl) {
        todaySummaryTextEl.textContent = `Select a region to see ${todayTargetDay}.`;
      }

      function getScheduleForTargetDay(card) {
        try {
          const schedule = JSON.parse(card.dataset.schedule || '[]');
          return schedule.find((item) => String(item.day || '').toLowerCase() === todayTargetDay.toLowerCase());
        } catch {
          return null;
        }
      }

      function showTodayRegion(region) {
        let visible = 0;

        todayRegionButtonsEl.forEach((button) => {
          button.classList.toggle('is-active', button.dataset.todayRegion === region);
        });

        if (todayGridEl) todayGridEl.hidden = false;

        todayCardsEl.forEach((card) => {
          const regionMatch = card.dataset.region === region;
          const slot = getScheduleForTargetDay(card);
          const fallbackDayMatch = (card.dataset.fallbackDays || '').includes(todayTargetDay.toLowerCase());
          const show = regionMatch && (slot || fallbackDayMatch);

          card.hidden = !show;

          if (show) {
            visible++;

            const meta = card.querySelector('.today-card-meta');
            const link = card.querySelector('.map-link');
            const title = card.querySelector('h3')?.textContent || 'workout';

            const time = slot?.time || card.dataset.fallbackTime || '';
            const city = slot?.city || '';
            const location = slot?.location || '';
            const mapUrl = slot?.mapUrl || card.dataset.fallbackMap || link?.href;

            if (meta) {
              meta.textContent = [region, city, time, location].filter(Boolean).join(' • ');
            }

            if (link && mapUrl) {
              link.href = mapUrl;
              link.setAttribute('aria-label', `Directions to ${title}`);
            }
          }
        });

        if (todaySummaryTextEl) {
          todaySummaryTextEl.textContent = visible
            ? `${visible} ${todayTargetDay} workout${visible === 1 ? '' : 's'} in ${region}.`
            : `No listed ${todayTargetDay} workouts in ${region}.`;
        }

        if (todayEmptyEl) {
          todayEmptyEl.textContent = visible
            ? ''
            : `No listed ${todayTargetDay} workouts found in ${region}.`;
          todayEmptyEl.hidden = visible !== 0;
        }
      }

      todayRegionButtonsEl.forEach((button) => {
        button.addEventListener('click', () => showTodayRegion(button.dataset.todayRegion));
      });

      if (defaultRegion !== 'all') showTodayRegion(defaultRegion);

    </script>
  </body>
</html>
